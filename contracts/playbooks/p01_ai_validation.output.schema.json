{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P01Report",
  "type": "object",
  "required": ["verdict", "confidence", "facts", "model"],
  "properties": {
    "summary": {"type": "string"},
    "verdict": {"type": "string", "enum": ["suspicious", "benign", "unclear"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "evidence"],
        "properties": {
          "text": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["line", "text"],
              "properties": {
                "line": {"type": "integer", "minimum": 1},
                "text": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "model": {"type": "string"}
  }
}
